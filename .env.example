# Скопируй в .env. Реальные ключи не коммить.
OPS_ENVIRONMENT=local
OPS_INCIDENT_ID=INC-2026-11-06-01
OPS_INCIDENT_DIR=data/incidents/INC-2026-11-06-01
OPS_ENTERPRISE_DIR=data
OPS_RUNS_DIR=./runs
OPS_CHECKPOINT_DB=./runs/checkpoints.sqlite

# RouterAI: OpenAI-совместимый API, https://routerai.ru/docs/guides
# Ключ можно положить в OPS_LLM_API_KEY или в переменную KEY.
OPS_LLM_PROVIDER=openai
OPS_LLM_MODEL=anthropic/claude-haiku-4.5
OPS_LLM_BASE_URL=https://routerai.ru/api/v1
OPS_LLM_API_KEY=
# KEY=sk-...
OPS_LLM_TEMPERATURE=0
OPS_LLM_MAX_TOKENS=8192

# Альтернативы:
# OPS_LLM_PROVIDER=anthropic
# OPS_LLM_MODEL=claude-haiku-4-5-20251001
# OPS_LLM_BASE_URL=https://llm.example.com/v1
#
# OPS_LLM_PROVIDER=openai
# OPS_LLM_MODEL=gpt-4o-mini
# OPS_LLM_BASE_URL=https://api.openai.com/v1
# OPS_LLM_API_KEY=...

# Guardrails
OPS_MAX_ITERATIONS=10
OPS_MAX_TOOL_ROUNDS=12
OPS_RUN_TIMEOUT_SECONDS=600
OPS_APP_PORT=8095

# LangFuse. Без ключей — JSONL-трейс в runs/{thread}.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Адрес LangFuse в контуре предприятия:
# LANGFUSE_HOST=https://langfuse.example.com
